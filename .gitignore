## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio
.LocalHistory/

# Mac / Linux
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Rider / JetBrains IDEs
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if necessary however generally it will be regenerated when needed
#!**/[Pp]ackages/repositories.config
# NuGet v3's project.json files produces more ignorable files
*.nuget.props
*.nuget.targets

# Microsoft Fakes
FakesAssemblies/

# GhostDoc plugin setting file
*.GhostDoc.xml

# Node.js Tools for Visual Studio
.ntvs_analysis.dat
node_modules/

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Trace Files
*.e2e

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# JetBrains dotCover workspace
*.dotCover

# Visual Studio Test Explorer
.utr

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# Testing
TestResults/
*.coverage
*.coveragexml

# .NET Core specific
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core environment specific appsettings
# Do not commit development secrets
appsettings.Development.json
appsettings.Local.json

# .NET tooling
.store/

# Cake - Uncomment if you are using it
# tools/**
# !tools/packages.config
# !tools/cake.packages.config
# !tools/Cake.targets